# DeFi Vault Dashboard - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git (it's already in .gitignore)

# Dune Analytics API Key (for Morpho curator data, liquidations fallback)
# Get yours at: https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# Helius API Key (for Kamino/Solana liquidation data)
# Get yours at: https://dev.helius.xyz/ (free tier: 100k requests/month)
HELIUS_API_KEY=your_helius_api_key_here

# Optional: The Graph API Key (for Aave liquidations)
# Get yours at: https://thegraph.com/studio/apikeys/
# GRAPH_API_KEY=your_graph_api_key_here

# Optional: DeFiLlama Pro API Key (not required, free tier works)
# DEFILLAMA_API_KEY=your_defillama_key_here
