# DeFi Vault Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's already in .gitignore).
#
# Each section below is marked REQUIRED, RECOMMENDED, or OPTIONAL:
#   - REQUIRED:    app will crash or be useless without it
#   - RECOMMENDED: app will run, but a feature degrades or relies on a
#                  rate-limited public endpoint that fails under any load
#   - OPTIONAL:    nice-to-have; commented out by default

# ---------------------------------------------------------------------------
# RECOMMENDED — Solana RPC
# ---------------------------------------------------------------------------
# Used by: src/app/api/curators/route.ts, src/app/api/kamino/route.ts,
#          src/app/api/curators/fees/route.ts
# Without it: falls back to https://api.mainnet-beta.solana.com (public),
# which is rate-limited to ~300 req/day and will silently fail under load.
# Paid options: Helius, QuickNode, Triton — pick whichever you prefer.
SOLANA_RPC_URL=https://your-paid-solana-rpc.example.com

# ---------------------------------------------------------------------------
# RECOMMENDED — Dune Analytics
# ---------------------------------------------------------------------------
# Used by: src/lib/dune.ts (Morpho curator cross-reference, liquidations fallback)
# Without it: dashboard still works, but `validation.duneDataAvailable: false`
# and curator TVL cross-validation is disabled.
# Get yours at: https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# ---------------------------------------------------------------------------
# RECOMMENDED — Helius (Solana liquidations)
# ---------------------------------------------------------------------------
# Used by: src/lib/liquidations.ts (Kamino/Solana liquidation event polling)
# Without it: Kamino liquidation tab will be empty.
# Get yours at: https://dev.helius.xyz/ (free tier: 100k requests/month)
HELIUS_API_KEY=your_helius_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL — The Graph (Aave liquidations)
# ---------------------------------------------------------------------------
# Used by: src/lib/liquidations.ts (Aave V3 liquidation subgraph queries)
# Without it: Aave liquidation events are skipped.
# Get yours at: https://thegraph.com/studio/apikeys/
# GRAPH_API_KEY=your_graph_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL — DeFiLlama Pro
# ---------------------------------------------------------------------------
# Free tier already works for everything we use.
# DEFILLAMA_API_KEY=your_defillama_key_here
